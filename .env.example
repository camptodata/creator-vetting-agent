# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Browser-safe publishable key (replaces anon key in new Supabase key format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (replaces service_role key in new Supabase key format)
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# SerpAPI — https://serpapi.com/manage-api-key (optional)
# When set, the Scout agent performs real web searches via SerpAPI.
# When unset, Scout falls back to synthetic-profile mode (good for local dev).
SERPAPI_KEY=

# Optional: your deployment URL (used for auth redirect in production)
NEXT_PUBLIC_SITE_URL=https://creator-vetting-agent.vercel.app
